+    pub(crate) fn replace_input_interaction(&mut self, widget: WidgetRect) {
+        let (index, stored) = self
+            .by_id
+            .get_mut(&widget.id)
+            .expect("widget was just inserted");
+        stored.enabled = widget.enabled;
+        stored.visible = widget.visible;
+        stored.sense = widget.sense;
+        self.by_layer
+            .get_mut(&widget.layer_id)
+            .expect("registered widgets have a layer")[*index] = *stored;
+    }
+
+    pub(crate) fn remove(&mut self, id: Id) {
+        if let Some((index, widget)) = self.by_id.remove(&id) {
+            let layer = self
+                .by_layer
+                .get_mut(&widget.layer_id)
+                .expect("registered widgets have a layer");
+            layer.remove(index);
+            for (index, widget) in layer.iter().enumerate().skip(index) {
+                self.by_id
+                    .get_mut(&widget.id)
+                    .expect("layer entries have an ID index")
+                    .0 = index;
+            }
+            self.infos.remove(&id);
+        }
+    }
+
+    pub(crate) fn remove_layer(&mut self, layer: LayerId) -> Vec<crate::Id> {
+        let ids: Vec<_> = self
+            .by_layer
+            .remove(&layer)
+            .unwrap_or_default()
+            .into_iter()
+            .map(|w| w.id)
+            .collect();
+        for id in &ids {
+            self.by_id.remove(id);
+            self.infos.remove(id);
+        }
+        ids
+    }
